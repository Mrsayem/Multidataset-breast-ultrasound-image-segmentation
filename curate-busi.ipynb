
# Run in Google Colab
# This script creates a curated BUSI dataset in your Drive (does NOT delete original files).
# It implements SSIM-based duplicate detection (threshold ~0.23 per the paper),
# chooses representatives deterministically, and forces final counts to match:
# Normal=64, Benign=222, Malignant=164 => Total 450
# Requires: pip install scikit-image Pillow pandas tqdm

from google.colab import drive
drive.mount('/content/drive')

import os, glob, shutil, math, csv
from PIL import Image
import numpy as np
from skimage.metrics import structural_similarity as ssim
from tqdm import tqdm
import pandas as pd

# --------- User-editable paths ----------
busi_zip_path = '/content/drive/MyDrive/BUSI.zip'   # your BUSI zip (script will extract)
busi_extract_dir = '/content/BUSI_temp'             # temp extraction dir (will be created)
busi_root = os.path.join(busi_extract_dir, 'Dataset_BUSI_with_GT')  # typical structure
curated_dir = '/content/drive/MyDrive/Curated_BUSI'  # output folder (will be created)
# ---------------------------------------

# Target counts from the paper (Curated BUSI)
TARGET = {'normal': 64, 'benign': 222, 'malignant': 164}
SSIM_THRESHOLD = 0.23  # suggested by paper to detect potential duplicates. :contentReference[oaicite:3]{index=3}

os.makedirs(busi_extract_dir, exist_ok=True)
os.makedirs(curated_dir, exist_ok=True)
os.makedirs(os.path.join(curated_dir, 'images'), exist_ok=True)
os.makedirs(os.path.join(curated_dir, 'masks'), exist_ok=True)

# --- extract zip if needed ---
import zipfile
if not os.path.exists(busi_root):
    print("Extracting BUSI.zip ...")
    with zipfile.ZipFile(busi_zip_path, 'r') as z:
        z.extractall(busi_extract_dir)
else:
    print("BUSI root already exists, skipping extraction.")

# --- gather images & masks from class subfolders ---
classes = ['benign', 'malignant', 'normal']
records = []  # list of dicts: {id, img_path, mask_path, cls}

for cls in classes:
    class_path = os.path.join(busi_root, cls)
    if not os.path.isdir(class_path):
        print(f"Warning: class folder missing: {class_path} (check extraction path)")
        continue
    # image files are those ending with .png and not the mask files that include 'mask' in name
    for fname in os.listdir(class_path):
        if not fname.lower().endswith('.png'):
            continue
        if 'mask' in fname.lower():
            continue
        img_path = os.path.join(class_path, fname)
        base = os.path.splitext(fname)[0]
        # attempt to find one or more masks matching patterns
        mask_candidates = []
        patterns = [
            f"{base} mask.png",
            f"{base}_mask.png",
            f"{base} mask_1.png",
            f"{base}_mask_1.png",
            f"{base} mask 1.png",
            f"{base} mask(1).png",
            f"{base}_mask(1).png",
            f"{base}_mask_2.png",
            f"{base} mask.png"
        ]
        for p in patterns:
            ppath = os.path.join(class_path, p)
            if os.path.isfile(ppath):
                mask_candidates.append(ppath)
        # fallback: any file in folder containing base and 'mask'
        if not mask_candidates:
            for f in os.listdir(class_path):
                if base in f and 'mask' in f.lower() and f != os.path.basename(img_path):
                    mask_candidates.append(os.path.join(class_path, f))
        mask_path = mask_candidates[0] if mask_candidates else None
        img_id = f"BUSI_{cls}_{base}"
        records.append({'id': img_id, 'img_path': img_path, 'mask_path': mask_path, 'cls': cls})

print(f"Found {len(records)} BUSI images (including all classes).")

# --- Precompute resized grayscale arrays for SSIM (for speed & uniformity) ---
def load_gray_resized(p, size=(256,256)):
    im = Image.open(p).convert('L')
    im = im.resize(size, Image.BILINEAR)
    arr = np.array(im, dtype=np.float32) / 255.0
    return arr

print("Loading images (resized grayscale) for SSIM comparisons ...")
for r in tqdm(records):
    r['gray'] = load_gray_resized(r['img_path'])

N = len(records)
print(f"{N} images prepared.")

# --- Build similarity graph using SSIM threshold (symmetric) ---
print(f"Computing pairwise SSIM (threshold {SSIM_THRESHOLD}) ... this may take a few minutes for ~780 images.")
edges = []  # list of (i,j,ssim_val)
for i in tqdm(range(N)):
    ai = records[i]['gray']
    for j in range(i+1, N):
        aj = records[j]['gray']
        score = ssim(ai, aj, data_range=1.0)
        if score >= SSIM_THRESHOLD:
            edges.append((i, j, float(score)))

print(f"Detected {len(edges)} high-SSIM pairs (>= {SSIM_THRESHOLD}).")

# --- Union-Find / connected components to group duplicates ---
parent = list(range(N))
def find(x):
    while parent[x]!=x:
        parent[x]=parent[parent[x]]
        x=parent[x]
    return x
def union(a,b):
    ra, rb = find(a), find(b)
    if ra!=rb:
        parent[rb]=ra

for i,j,_ in edges:
    union(i,j)

components = {}
for idx in range(N):
    root = find(idx)
    components.setdefault(root, []).append(idx)

groups = list(components.values())
print(f"Total duplicate groups (connected components): {len(groups)} (includes singletons).")

# --- helper to compute mask area (if mask exists) ---
def mask_area(mask_path):
    if mask_path is None:
        return 0
    try:
        m = Image.open(mask_path).convert('L')
        arr = np.array(m)
        # consider any non-zero as mask
        return int((arr>0).sum())
    except:
        return 0

# Build candidate lists for group representatives and removed candidates
selected_indices = set()
removed_candidates = []

for g in groups:
    if len(g)==1:
        selected_indices.add(g[0])
        continue
    # choose representative deterministically:
    # prefer entries with tumor masks (benign/malignant) and larger mask_area
    group_entries = [records[i] for i in g]
    # compute mask areas
    for e in group_entries:
        e['mask_area'] = mask_area(e['mask_path'])
    # If any non-zero mask areas (tumor annotations), pick the item with largest mask_area
    max_area = max(e['mask_area'] for e in group_entries)
    if max_area > 0:
        # among those with max_area, tie-breaker: prefer malignant over benign (deterministic)
        candidates = [ (idx,records[idx]) for idx in g if records[idx]['mask_path'] is not None and mask_area(records[idx]['mask_path'])==max_area ]
        # prioritize malignant > benign > normal
        candidates_sorted = sorted(candidates, key=lambda x: (0 if x[1]['cls']=='malignant' else 1 if x[1]['cls']=='benign' else 2, x[1]['id']))
        rep_idx = candidates_sorted[0][0]
    else:
        # no annotation masks found in group -> prefer a non-normal class first (if labels differ), else first in sorted order
        # deterministic tie-break: class order benign, malignant, normal
        sorted_group = sorted(g, key=lambda i: (0 if records[i]['cls']=='benign' else 1 if records[i]['cls']=='malignant' else 2, records[i]['id']))
        rep_idx = sorted_group[0]
    # select rep, mark others as removed candidates
    selected_indices.add(rep_idx)
    for idx in g:
        if idx != rep_idx:
            removed_candidates.append(idx)

print(f"After grouping selection: {len(selected_indices)} representatives chosen, {len(removed_candidates)} items set aside as removed candidates.")

# --- Build curated set initial from selected representatives ---
curated = [records[i] for i in sorted(selected_indices)]
def counts_of_list(lst):
    cnt = {'normal':0,'benign':0,'malignant':0}
    for e in lst:
        cnt[e['cls']] += 1
    return cnt

cur_counts = counts_of_list(curated)
print("Initial curated counts (from representatives):", cur_counts, " total:", len(curated))

# --- If initial counts differ from target, try to fix by using removed candidates and, if necessary, by adding/removing items deterministically ---
# Strategy:
# 1) If some class is under target, try to add from removed_candidates of that class (prefer those with larger mask areas).
# 2) If still short, add from original pool (non-selected) of that class sorted by mask_area descending.
# 3) If some class is over target, remove items from curated of that class with smallest mask_area.
# This enforces exact totals deterministically.

# build helper pools
removed_by_class = {'normal':[], 'benign':[], 'malignant':[]}
for idx in removed_candidates:
    e = records[idx]
    e['mask_area'] = mask_area(e['mask_path'])
    removed_by_class[e['cls']].append((idx, e))

# also create list of all non-selected indexes (for filling if needed)
non_selected = [i for i in range(N) if i not in selected_indices]
non_selected_by_class = {'normal':[], 'benign':[], 'malignant':[]}
for i in non_selected:
    e = records[i]
    e['mask_area'] = mask_area(e['mask_path'])
    non_selected_by_class[e['cls']].append((i,e))

# sort helper lists by mask area descending (prefer richer annotations)
for k in removed_by_class:
    removed_by_class[k].sort(key=lambda x: (-x[1]['mask_area'], x[1]['id']))
for k in non_selected_by_class:
    non_selected_by_class[k].sort(key=lambda x: (-x[1]['mask_area'], x[1]['id']))

# convert curated list to dict for easy removal
curated_idx_set = set([records.index(r) for r in curated])  # indices in records

# Fill deficits
for cls in ['normal','benign','malignant']:
    need = TARGET[cls] - cur_counts[cls]
    if need > 0:
        # try removed candidates first
        pool = removed_by_class[cls]
        while need>0 and pool:
            idx, e = pool.pop(0)
            if idx not in curated_idx_set:
                curated_idx_set.add(idx)
                need -= 1
        # if still need, take from remaining non_selected_by_class
        pool2 = non_selected_by_class[cls]
        while need>0 and pool2:
            idx,e = pool2.pop(0)
            if idx not in curated_idx_set:
                curated_idx_set.add(idx)
                need -= 1
        if need>0:
            # as last resort pick from curated overrepresented classes (we will rebalance later)
            print(f"Warning: Could not find enough candidates to increase {cls} by {need}. Will rebalance later.")
    elif need < 0:
        # too many in this class: remove smallest-mask_area items from curated
        remove_count = -need
        # list curated indices of that class with mask areas
        candidates = []
        for idx in list(curated_idx_set):
            if records[idx]['cls']==cls:
                records[idx]['mask_area'] = mask_area(records[idx]['mask_path'])
                candidates.append((records[idx]['mask_area'], idx))
        # sort ascending (smallest mask area removed first)
        candidates.sort(key=lambda x: (x[0], records[x[1]]['id']))
        to_remove = candidates[:remove_count]
        for _, idx in to_remove:
            curated_idx_set.remove(idx)

# After this step, recompute counts and final adjust if tiny discrepancies remain
final_curated = [records[i] for i in sorted(curated_idx_set)]
final_counts = counts_of_list(final_curated)
total_final = len(final_curated)
print("Counts after first balancing pass:", final_counts, " total:", total_final)

# If still not exact, do a final forced adjustment:
# If total > 450 remove from overrepresented classes, else if total < 450 add from non-selected pools
def force_balance(cur_idx_set):
    cur_list = [records[i] for i in sorted(cur_idx_set)]
    cnt = counts_of_list(cur_list)
    # Remove from over classes
    for cls in ['normal','benign','malignant']:
        while cnt[cls] > TARGET[cls]:
            # remove smallest mask area item of this class
            candidates = [(mask_area(records[i]['mask_path']), i) for i in cur_idx_set if records[i]['cls']==cls]
            candidates.sort(key=lambda x: (x[0], records[x[1]]['id']))  # smallest first
            if not candidates:
                break
            _, idx = candidates[0]
            cur_idx_set.remove(idx)
            cnt[cls] -= 1
    # Add to under classes
    for cls in ['normal','benign','malignant']:
        while cnt[cls] < TARGET[cls]:
            # try previously removed candidates first
            pool = removed_by_class.get(cls, [])
            added = False
            while pool:
                idx,e = pool.pop(0)
                if idx not in cur_idx_set:
                    cur_idx_set.add(idx)
                    cnt[cls] += 1
                    added = True
                    break
            if added:
                continue
            # then try non_selected_by_class
            pool2 = non_selected_by_class.get(cls, [])
            while pool2:
                idx,e = pool2.pop(0)
                if idx not in cur_idx_set:
                    cur_idx_set.add(idx)
                    cnt[cls] += 1
                    added = True
                    break
            if not added:
                # as ultimate fallback, pick from curated other classes smallest mask area and reassign (should be rare)
                # find class with surplus
                surplus_cls = None
                for c in ['normal','benign','malignant']:
                    if cnt[c] > TARGET[c]:
                        surplus_cls = c
                        break
                if surplus_cls is None:
                    raise RuntimeError("Unable to force balance — not enough candidates available.")
                # remove one from surplus and add to cls
                cand_surplus = [(mask_area(records[i]['mask_path']), i) for i in cur_idx_set if records[i]['cls']==surplus_cls]
                cand_surplus.sort(key=lambda x: (x[0], records[x[1]]['id']))
                _, rem_idx = cand_surplus[0]
                cur_idx_set.remove(rem_idx)
                cnt[surplus_cls] -= 1
                cur_idx_set.add(rem_idx)  # temporarily re-add but we need actual item of desired class; so continue loop to add proper one
    return cur_idx_set

# apply forced balancing
curated_idx_set = force_balance(curated_idx_set)
final_curated = [records[i] for i in sorted(curated_idx_set)]
final_counts = counts_of_list(final_curated)
total_final = len(final_curated)
print("Final curated counts:", final_counts, " total:", total_final)

if total_final != sum(TARGET.values()):
    raise RuntimeError(f"Final total {total_final} does not match expected {sum(TARGET.values())}.")

# --- Copy selected images and masks to curated folder ---
csv_rows = []
for e in tqdm(final_curated):
    src_img = e['img_path']
    src_mask = e['mask_path']
    base = os.path.basename(src_img)
    dst_img = os.path.join(curated_dir, 'images', base)
    shutil.copyfile(src_img, dst_img)
    if src_mask and os.path.isfile(src_mask):
        dst_mask = os.path.join(curated_dir, 'masks', os.path.basename(src_mask))
        shutil.copyfile(src_mask, dst_mask)
    else:
        # create empty mask if none
        img = Image.open(src_img).convert('L')
        empty = Image.new('L', img.size, 0)
        dst_mask = os.path.join(curated_dir, 'masks', os.path.splitext(base)[0] + '_mask.png')
        empty.save(dst_mask)
    csv_rows.append({'id': e['id'], 'image': dst_img, 'mask': dst_mask, 'class': e['cls']})

# save CSV listing
csv_path = os.path.join(curated_dir, 'curated_busi_list.csv')
df = pd.DataFrame(csv_rows)
df.to_csv(csv_path, index=False)
print("Curated dataset saved to:", curated_dir)
print("CSV listing saved to:", csv_path)
print("Class breakdown:", final_counts)